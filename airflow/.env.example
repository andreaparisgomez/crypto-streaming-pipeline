AIRFLOW_UID=501
AIRFLOW_PROJ_DIR=/path/to/crypto-streaming-pipeline/airflow

# =========================
# LOCAL POSTGRES DATABASE
# =========================

POSTGRES_HOST=host.docker.internal
POSTGRES_DB=crypto_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# =========================
# NEON CLOUD WAREHOUSE
# =========================

WAREHOUSE_HOST=your-neon-host.neon.tech
WAREHOUSE_DB=neondb
WAREHOUSE_USER=your_neon_username
WAREHOUSE_PASSWORD=your_neon_password
WAREHOUSE_SSLMODE=require

# =========================
# AIRFLOW CONFIG
# =========================

FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=jwt_secret
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow_admin_password
